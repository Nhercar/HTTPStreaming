# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.html ext eol=lf

# CMake
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Documentation
*.md text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
*.jpg binary
*.png binary